NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# combo_shop_app has no BYPASSRLS — see CLAUDE.md section 5. Never point
# the running app at the combo_shop superuser; RLS silently no-ops for it.
# Port 45432, not 5432 — this machine has another project's Postgres
# already on the standard port, and 5433 turned out to fall inside a
# Windows dynamic port exclusion range (see docker-compose.yml).
DATABASE_URL=postgres://combo_shop_app:combo_shop_app@localhost:45432/combo_shop
DATABASE_POOL_MAX=10

# Superuser connection, used only by drizzle-kit (generate/migrate) for
# DDL — never imported by application code. See src/db/init/001-app-role.sql.
DATABASE_ADMIN_URL=postgres://combo_shop:combo_shop@localhost:45432/combo_shop

REDIS_URL=redis://localhost:6380

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=combo_shop
MINIO_SECRET_KEY=combo_shop_secret
MINIO_BUCKET=combo-shop-media
# Only needed when browsers reach MinIO at a different address than the API
# does (production: the API uses the Docker hostname, browsers go through
# Caddy/Cloudflare). Presigned upload URLs are built against these; each
# defaults to its MINIO_* counterpart above.
# MINIO_PUBLIC_ENDPOINT=media.example.com
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true
# Base URL that serves the bucket's public/ prefix (processed pictures).
# Derived from the MinIO settings when unset — right for local development.
# MEDIA_PUBLIC_BASE_URL=https://media.example.com/combo-shop-media

SUPERTOKENS_CONNECTION_URI=http://localhost:43570
SUPERTOKENS_API_KEY=

# Guards POST /tenancy (creating a store) until a platform-admin role exists.
# Send it as the x-platform-key header. Unset = that endpoint is disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PLATFORM_API_KEY=

# Reverse proxies in front of the API (Cloudflare + Caddy = 2). 0 in local dev.
# Required for correct client IPs, and therefore rate limits, in production.
TRUST_PROXY_HOPS=0
# Bearer token for GET /metrics. In production the endpoint is OFF without it.
# METRICS_TOKEN=

RESEND_API_KEY=
# Sender for login codes. onboarding@resend.dev only works for Resend's own
# test recipient; verify a real domain there before going live.
EMAIL_FROM=onboarding@resend.dev

TROPIPAY_CLIENT_ID=
TROPIPAY_CLIENT_SECRET=
TROPIPAY_ENV=sandbox

# Only read by `npm run db:seed:admin` — creates the first staff login for a tenant.
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Shop
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
