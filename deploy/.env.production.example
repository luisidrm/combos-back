# Copy to deploy/.env.production and fill in. This file is read by `docker compose --env-file`; it is never
# committed (back/.gitignore ignores .env.*). Generate every secret with:  openssl rand -base64 32 | tr -d '=+/' | cut -c1-40

# --- names (one registrable domain, so the session cookie works: see COOKIE_DOMAIN) -----------------------------
SITE_DOMAIN=pacasa.net
API_DOMAIN=api.pacasa.net
MEDIA_DOMAIN=media.pacasa.net
# Starts with a dot: the cookie is shared by pacasa.net and api.pacasa.net.
COOKIE_DOMAIN=.pacasa.net
# Which store the website shows (the slug created by `npm run seed:admin`).
TENANT_SLUG=pacasa
# Where Let's Encrypt sends certificate warnings: a real inbox you read.
ACME_EMAIL=

# --- database ------------------------------------------------------------------------------------------------
# The owner (superuser): used ONLY by the one-off migrate job. The API never receives this password.
POSTGRES_USER=combo_shop
POSTGRES_PASSWORD=
# The role the API connects as (no superuser, no BYPASSRLS). Created on the first start of an empty volume.
APP_DB_PASSWORD=

# --- object storage (pictures) -------------------------------------------------------------------------------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=combo-shop-media

# --- login ---------------------------------------------------------------------------------------------------
# Protects the SuperTokens core, which is not reachable from outside anyway.
SUPERTOKENS_API_KEY=
# Used once to create the store over HTTP; may be left empty if you use `npm run seed:admin` instead.
PLATFORM_API_KEY=
# Bearer token for GET /metrics (optional).
METRICS_TOKEN=

# --- email (Resend): the domain must be verified there, or mail reaches only the account owner ---------------------
RESEND_API_KEY=
EMAIL_FROM=Pa'Casa <pedidos@pacasa.net>

# --- sign in with Google (optional; see docs/DEPLOY-PLAN.md section 3). Both keys, then WEB_GOOGLE_SIGNIN=true and rebuild the web image.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_GOOGLE_SIGNIN=false

# --- monitoring (optional; nothing is sent until a DSN is set) ----------------------------------------------------
SENTRY_DSN=
WEB_SENTRY_DSN=

# --- release label for image tags (deploy.sh sets it to the git commit) ----------------------------------------------
RELEASE=latest
